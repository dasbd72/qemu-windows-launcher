#!/usr/bin/env python3
import os
import sys

# In a dev checkout this file sits in bin/ next to src/qemu_wtg; once
# installed by the AUR package it's copied to /usr/bin on its own, with
# qemu_wtg living under /usr/lib/qemu-wtg instead. Checked for the qemu_wtg
# subdirectory specifically, not just src/'s existence -- /usr/../src
# resolves to /usr/src, which commonly exists already (kernel headers).
_DEV_SRC_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src")
_INSTALLED_SRC_DIR = "/usr/lib/qemu-wtg"
_SRC_DIR = (
    _DEV_SRC_DIR if os.path.isdir(os.path.join(_DEV_SRC_DIR, "qemu_wtg")) else _INSTALLED_SRC_DIR
)
sys.path.insert(0, _SRC_DIR)

from qemu_wtg.cli import main

if __name__ == "__main__":
    sys.exit(main())
